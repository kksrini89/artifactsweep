{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArtifactSweep",
  "version": "0.2.2",
  "identifier": "com.artifactsweep.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArtifactSweep",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/sweep"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Scan and clean developer build artifacts",
    "longDescription": "ArtifactSweep finds regeneratable folders such as node_modules and target, shows sizes, and lets you clean selected paths. Includes the sweep CLI on PATH when installed via the desktop installer.",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
